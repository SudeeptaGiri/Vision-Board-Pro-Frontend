generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  goals         Goal[]
  visionBoards  VisionBoard[]
  habits        Habit[]
  categories    Category[]
  streaks       Streak[]

  @@map("users")
}

// ==================== CATEGORIES ====================

model Category {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6366f1")
  icon        String   @default("target")
  userId      String
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       Goal[]

  @@unique([userId, name])
  @@map("categories")
}

// ==================== GOALS ====================

model Goal {
  id              String      @id @default(cuid())
  title           String
  description     String?
  type            GoalType    @default(ACHIEVEMENT)
  status          GoalStatus  @default(NOT_STARTED)
  priority        Priority    @default(MEDIUM)
  targetDate      DateTime?
  completedAt     DateTime?
  progress        Int         @default(0)  // 0-100
  
  // AI Generated Context
  aiContext       Json?       // Stores questionnaire answers
  aiSuggestions   Json?       // Stores AI recommendations
  
  // Relations
  userId          String
  categoryId      String?
  parentGoalId    String?     // For sub-goals
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?   @relation(fields: [categoryId], references: [id])
  parentGoal      Goal?       @relation("SubGoals", fields: [parentGoalId], references: [id])
  subGoals        Goal[]      @relation("SubGoals")
  
  tasks           Task[]
  visionItems     VisionItem[]
  milestones      Milestone[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, status])
  @@map("goals")
}

enum GoalType {
  ACHIEVEMENT     // One-time goal (trip, project)
  LEARNING        // Skill development (ukulele, coding)
  HEALTH          // Health & fitness
  HABIT           // Recurring habit
  FINANCIAL       // Money-related
  CAREER          // Professional goals
  PERSONAL        // Personal development
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ABANDONED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==================== TASKS (Kanban Items) ====================

model Task {
  id              String      @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus  @default(TODO)
  priority        Priority    @default(MEDIUM)
  order           Int         @default(0)
  
  // Scheduling
  dueDate         DateTime?
  scheduledDate   DateTime?
  estimatedTime   Int?        // in minutes
  actualTime      Int?        // in minutes
  
  // For recurring tasks (habits)
  isRecurring     Boolean     @default(false)
  recurrenceRule  String?     // RRULE format
  
  // AI generated
  isAiGenerated   Boolean     @default(false)
  aiNotes         String?
  
  // Relations
  goalId          String
  goal            Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  completions     TaskCompletion[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?

  @@index([goalId, status])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

// Track completions for recurring tasks
model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  completedAt DateTime @default(now())
  notes       String?
  
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_completions")
}

// ==================== MILESTONES ====================

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())

  @@map("milestones")
}

// ==================== HABITS & STREAKS ====================

model Habit {
  id              String        @id @default(cuid())
  title           String
  description     String?
  frequency       HabitFrequency @default(DAILY)
  targetPerPeriod Int           @default(1)
  color           String        @default("#10b981")
  icon            String        @default("check-circle")
  isActive        Boolean       @default(true)
  
  // Reminder settings
  reminderTime    String?       // HH:mm format
  reminderDays    Int[]         // 0-6 for days of week
  
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  logs            HabitLog[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("habits")
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model HabitLog {
  id          String   @id @default(cuid())
  habitId     String
  date        DateTime @db.Date
  completed   Boolean  @default(true)
  notes       String?
  
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  @@unique([habitId, date])
  @@map("habit_logs")
}

model Streak {
  id            String   @id @default(cuid())
  userId        String
  type          String   // 'habit', 'daily-tasks', 'goals'
  referenceId   String?  // habitId or null for general
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  updatedAt     DateTime @updatedAt

  @@unique([userId, type, referenceId])
  @@map("streaks")
}

// ==================== VISION BOARD ====================

model VisionBoard {
  id              String       @id @default(cuid())
  title           String
  description     String?
  isDefault       Boolean      @default(false)
  background      String?      // Background image or color
  backgroundColor String?      @default("#f8fafc")
  theme           String?      @default("default")
  layout          Json?        // Grid layout configuration
  
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items           VisionItem[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("vision_boards")
}

model VisionItem {
  id              String    @id @default(cuid())
  type            VisionItemType
  title           String?
  imageUrl        String?
  imagePublicId   String?   // Cloudinary public ID for deletion
  quote           String?
  
  // Position & Size
  positionX       Int       @default(0)
  positionY       Int       @default(0)
  width           Int       @default(200)
  height          Int       @default(200)
  rotation        Int       @default(0)
  zIndex          Int       @default(1)
  order           Int       @default(0)
  
  // Styling
  style           Json?     // Custom styles
  
  visionBoardId   String
  goalId          String?   // Link to a goal
  
  visionBoard     VisionBoard @relation(fields: [visionBoardId], references: [id], onDelete: Cascade)
  goal            Goal?       @relation(fields: [goalId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("vision_items")
}

enum VisionItemType {
  IMAGE
  GOAL_CARD
  QUOTE
  TEXT
  PROGRESS
}

// ==================== AI QUESTIONNAIRE TEMPLATES ====================

model QuestionnaireTemplate {
  id          String   @id @default(cuid())
  goalType    GoalType
  questions   Json     // Array of question objects
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([goalType, version])
  @@map("questionnaire_templates")
}